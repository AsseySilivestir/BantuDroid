<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOM DOMAIN"
            android:textColor="@color/bantu_green"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wire a domain (e.g. splannes.co.tz) directly to your tunnel. No Cloudflare needed — uses your existing Render + registrar."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Instructions -->
        <TextView
            android:id="@+id/tv_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <!-- Domain input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your domain"
            android:textColor="@color/bantu_green"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_domain"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="splannes.co.tz"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <!-- Action buttons -->
        <Button
            android:id="@+id/btn_add_to_render"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="1. Add Domain to Render"
            android:textSize="14sp"
            android:backgroundTint="#FFB74D"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_check_status"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="2. Check SSL Status"
            android:textSize="13sp"
            android:backgroundTint="#64B5F6"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_list_domains"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="List All Domains on Render (diagnostic)"
            android:textSize="12sp"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_bind"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="3. Bind Domain to Tunnel"
            android:textSize="14sp"
            android:backgroundTint="@color/bantu_green"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_unbind"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Unbind Domain"
            android:textSize="13sp"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_open_browser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Open in Browser"
            android:textSize="13sp"
            android:backgroundTint="#4CAF50"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_start_tunnel_first"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Start Bantu Tunnel First"
            android:textSize="13sp"
            android:backgroundTint="#FFB74D"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Status -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <!-- Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log"
            android:textColor="@color/bantu_green"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:gravity="top" />

    </LinearLayout>
</ScrollView>
