<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/bantu_green"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Engine Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_engine"
            android:textColor="@color/bantu_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_engine_version"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_engine_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.0.0"
                android:textColor="@color/bantu_green"
                android:textSize="14sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reinstall"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/settings_reinstall"
            android:backgroundTint="@color/bg_input"
            android:textColor="@color/text_error"
            android:layout_marginBottom="24dp" />

        <!-- Server Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_server"
            android:textColor="@color/bantu_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_default_port"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_default_port"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:background="@color/bg_input"
                android:textColor="@color/bantu_green"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:inputType="number"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_autostart"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/bantu_green"
                android:trackTint="@color/bg_input" />
        </LinearLayout>

        <!-- DDNS Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_ddns"
            android:textColor="@color/bantu_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_ddns_domain"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="@string/settings_ddns_domain"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_ddns_token"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="@string/settings_ddns_token"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save_ddns"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Save DDNS Settings"
            android:backgroundTint="@color/bantu_green"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <!-- Bantu Tunnel Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BANTU TUNNEL (self-hosted)"
            android:textColor="@color/bantu_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deploy your own bantu-tunnel server on Render (free), then paste its URL here."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_bantu_server_url"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="Server URL (https://your-app.onrender.com)"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_bantu_subdomain"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="Subdomain (optional, e.g. myapp)"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_bantu_token"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="Auth token (optional, only if server requires)"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save_bantu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Save Bantu Tunnel Settings"
            android:backgroundTint="@color/bantu_green"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <!-- Render API Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RENDER API (for custom domains)"
            android:textColor="@color/bantu_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lets BantuDroid add custom domains to your bantu-tunnel Render service automatically. Get an API key at dashboard.render.com/users/me/api-keys (needs Write scope)."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_render_api_key"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="Render API key (rnd_...)"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service ID (manual — use if auto-detect fails)"
            android:textColor="@color/bantu_green"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_render_service_id"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:hint="srv-xxxxxxxxxxxxxxxxxxxx"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save_render"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Save Settings"
            android:backgroundTint="@color/bantu_green"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_auto_detect_render"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Auto-detect Service"
            android:backgroundTint="#FFB74D"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Test API Connection (diagnostic)"
            android:backgroundTint="#64B5F6"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_render_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not configured"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@color/bg_card"
            android:padding="8dp"
            android:layout_marginBottom="24dp" />

        <!-- About Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_about"
            android:textColor="@color/bantu_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
