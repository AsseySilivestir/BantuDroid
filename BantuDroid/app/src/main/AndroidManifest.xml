<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access for DDNS updates & web hosting -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Check connectivity before starting server -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- UPnP SSDP multicast discovery -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Access wifi state for UPnP -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keep server running when screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service for background server -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read/write external storage for .b files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BantuDroid"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        tools:targetApi="34">

        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Terminal emulator -->
        <activity
            android:name=".TerminalActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboard" />

        <!-- File manager for .b files -->
        <activity
            android:name=".FileManagerActivity"
            android:exported="false" />

        <!-- WebView dashboard -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Hosting & Tunnel Dashboard -->
        <activity
            android:name=".HostingDashboardActivity"
            android:exported="false"
            android:label="@string/hosting_title" />

        <!-- Background server service -->
        <service
            android:name=".ServerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>
</manifest>
